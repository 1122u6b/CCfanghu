<Project Sdk="Microsoft.NET.Sdk">
 <!-- Leyra background service for macOS (runs as root under launchd). Shares the platform-neutral core with the
      Windows client by reference only; nothing under windows/ is changed for the Mac. -->
 <PropertyGroup>
  <OutputType>Exe</OutputType><TargetFramework>net8.0</TargetFramework>
  <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
  <AssemblyName>leyra-agent</AssemblyName><RootNamespace>Leyra.Mac.Agent</RootNamespace>
  <RuntimeIdentifiers>osx-arm64;osx-x64</RuntimeIdentifiers>
  <!-- Compiled to machine code when published (no .NET runtime or readable IL ships). JSON is written by LeyraJson and
       read through source-generated AgentJson; run-time JSON reflection stays off so nothing relies on it. -->
  <PublishAot>true</PublishAot><JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
  <StripSymbols>true</StripSymbols><IlcGenerateStackTraceData>false</IlcGenerateStackTraceData>
 </PropertyGroup>
 <ItemGroup>
  <!-- LeyraJson reads the properties of Leyra's own objects: keep them all in the machine-code build. -->
  <TrimmerRootAssembly Include="leyra-agent" />
 </ItemGroup>
 <ItemGroup Condition="'$(LeyraOneAssembly)'!='true'">
  <ProjectReference Include="../../windows/Leyra.Windows.Core/Leyra.Windows.Core.csproj" />
  <TrimmerRootAssembly Include="Leyra.Windows.Core" />
 </ItemGroup>
 <!-- Shipped build (scripts/aot_publish.py): the shared code is compiled into the service itself, so one assembly is
      obfuscated and then compiled to machine code. -->
 <ItemGroup Condition="'$(LeyraOneAssembly)'=='true'">
  <Compile Include="../../windows/Leyra.Windows.Core/**/*.cs" Exclude="../../windows/Leyra.Windows.Core/obj/**;../../windows/Leyra.Windows.Core/bin/**" />
 </ItemGroup>
</Project>
